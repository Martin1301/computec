model DOCENTE_CURSO {
  COD_DOCENTE String    @db.VarChar(8)
  IDCURSO     String    @db.VarChar(4)
  COD_HORARIO String    @db.VarChar(3)
  DESDE       DateTime? @db.Date
  HASTA       DateTime? @db.Date
  ESTADO      String    @db.VarChar(1)
  IDOPERA     String    @id(map: "PK_DOCENTE_CURSO") @db.VarChar(8)
}

model MARCACION {
  IDMARCA       String   @id(map: "PK_MARCACION") @db.VarChar(8)
