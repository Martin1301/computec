  HORAMARCA     String?  @db.VarChar(8)
  CODALUMNO     String   @db.VarChar(8)
  CODASIGNATURA String?  @db.VarChar(3)
  CODDOCENTE    String?  @db.VarChar(8)
  IDOPERA       String?  @db.VarChar(8)
}

model MATRICULA_C {
  COD_MATRICULA String @id @db.VarChar(20) // Ajustado como ID único para el cliente
  CODALUMNO     String @db.VarChar(8)
  ESTADO        String @db.VarChar(1)
}

model MATRICULA_D {
  ID_CURSO    String   @db.VarChar(10)
  COD_DOCENTE String   @db.VarChar(10)
  F_DESDE     DateTime @db.DateTime
  F_HASTA     DateTime @db.DateTime
  COD_ESTADO  String   @db.VarChar(1)

  @@id([ID_CURSO, COD_DOCENTE])
}


model MENU {
  cod_menu Int    @id
  des_menu String @db.VarChar(100)
  val_menu String? @db.VarChar(12)
}

model MENU_SUB {
  cod_submenu Int    @id
