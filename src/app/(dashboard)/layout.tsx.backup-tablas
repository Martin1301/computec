import Sidebar from "@/components/Sidebar";
import { getSession } from "@/lib/session";
import { redirect } from "next/navigation";

export const instant = false;

export default async function DashboardLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  const session = await getSession();

  if (!session) {
    redirect("/");
  }

  return (
    <div className="flex min-h-screen bg-slate-100 text-slate-900 antialiased">
      <Sidebar nombreUsuario={session.nombre} />

      <main className="min-w-0 flex-1 overflow-y-auto p-4 md:p-6">
        <div className="mb-4 text-right text-sm text-slate-500">
          Sesión iniciada:{" "}
          <span className="font-semibold text-slate-700">
            {session.nombre}
          </span>
        </div>

        <div className="min-w-0 max-w-full overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-5">
          {children}
        </div>
      </main>
    </div>
  );
}